{
  "openapi": "3.1.0",
  "info": {
    "title": "Qube Crypto Research & Binance Square API",
    "version": "2.1.0",
    "description": "Mobile-capable Action API for secure Binance Square publishing, public X discovery, and specialized crypto research. The Binance credential stays server-side."
  },
  "servers": [
    {
      "url": "https://binance-square-mcp.onrender.com"
    }
  ],
  "security": [
    {
      "MobilePublishKey": []
    }
  ],
  "paths": {
    "/api/publish": {
      "post": {
        "operationId": "publishBinanceSquarePost",
        "summary": "Publish a text post to Binance Square",
        "description": "Publishes the supplied text. Existing endpoint retained for backwards compatibility.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Binance publishing failure"
          }
        }
      }
    },
    "/api/publish/images": {
      "post": {
        "operationId": "publishBinanceSquareImages",
        "summary": "Publish images or an image-cover article to Binance Square",
        "description": "Downloads HTTPS media URLs server-side and publishes 1 to 4 images, or an article with one cover image. Conversation-generated or uploaded images can be passed through the runtime file-reference field.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImagePublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Binance or media failure"
          }
        }
      }
    },
    "/api/publish/video": {
      "post": {
        "operationId": "publishBinanceSquareVideo",
        "summary": "Publish a video to Binance Square",
        "description": "Downloads an HTTPS video URL server-side, derives duration when possible, creates a cover frame, and publishes the video.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoPublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Binance, media or ffmpeg failure"
          }
        }
      }
    },
    "/api/x/search": {
      "get": {
        "operationId": "searchPublicXPosts",
        "summary": "Search public X posts",
        "description": "Searches public X data through the configured third-party public-data service. No X API token is required server-side.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing query"
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "X service failure"
          }
        }
      }
    },
    "/api/x/trends": {
      "get": {
        "operationId": "getPublicXTrends",
        "summary": "Discover public X trends",
        "description": "Derives trend-like hashtags from public X search data. No X API token is required server-side.",
        "parameters": [
          {
            "name": "maxTrends",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trend results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "X service failure"
          }
        }
      }
    },
    "/api/research/market": {
      "get": {
        "operationId": "researchMarketData",
        "summary": "Get current market data",
        "description": "Uses Binance public market endpoints for a current 24h ticker and recent candles.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTCUSDT"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h",
              "enum": [
                "1m",
                "5m",
                "15m",
                "30m",
                "1h",
                "2h",
                "4h",
                "6h",
                "8h",
                "12h",
                "1d"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Market data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Market data failure"
          }
        }
      }
    },
    "/api/research/token": {
      "get": {
        "operationId": "researchTokenData",
        "summary": "Research token market and developer data",
        "description": "Uses CoinGecko public data for current market, supply and developer metadata.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "CoinGecko token ID, for example bitcoin or ethereum.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token research",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing token ID"
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Token data failure"
          }
        }
      }
    },
    "/api/research/defi": {
      "get": {
        "operationId": "researchDefiProtocol",
        "summary": "Research a DeFi protocol",
        "description": "Uses DefiLlama public data for protocol TVL, chains, category and related metrics.",
        "parameters": [
          {
            "name": "protocol",
            "in": "query",
            "required": true,
            "description": "DefiLlama protocol slug, for example aave or lido.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "DeFi research",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing protocol"
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "DeFi data failure"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublishRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "Exact text to publish."
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional article title."
          }
        }
      },
      "ImagePublishRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "format": "uri",
              "description": "HTTPS image URL."
            }
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional article title. When set, provide cover instead of images."
          },
          "cover": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS article cover image URL."
          },
          "openai\u0046ileIdRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string"},
            "description": "Images generated by ChatGPT or uploaded in the conversation. Runtime supplies temporary download links for these file references."
          }
        }
      },
      "VideoPublishRequest": {
        "type": "object",
        "required": [
          "video"
        ],
        "additionalProperties": false,
        "properties": {
          "video": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS video URL."
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Duration in seconds. Omit when the server can derive it with ffprobe."
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          }
        }
      },
      "PublishResponse": {
        "type": "object",
        "required": [
          "ok",
          "published"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "published": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "MobilePublishKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "secret"
      }
    }
  }
}
